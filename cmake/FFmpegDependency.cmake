# Explicit private static prefixes only. Never discover a system FFmpeg fallback.
if(NOT CAPTURE_FFMPEG_ROOT)
    message(FATAL_ERROR "CAPTURE_FFMPEG_ROOT is required; run scripts/build-native.sh to build the pinned minimal dependency")
endif()
get_filename_component(CAPTURE_DEPENDENCY_ROOT "${CMAKE_CURRENT_LIST_DIR}/.." ABSOLUTE)
file(READ "${CAPTURE_DEPENDENCY_ROOT}/Dependencies.lock.json" capture_dependency_lock)
string(JSON capture_ffmpeg_hash GET "${capture_dependency_lock}" ffmpeg sha256)
find_package(Threads REQUIRED)

function(capture_import_ffmpeg name prefix fixtures)
    if(NOT EXISTS "${prefix}/capture-build.json")
        message(FATAL_ERROR "${name}: missing verified FFmpeg prefix at ${prefix}; no system fallback is allowed")
    endif()
    file(READ "${prefix}/capture-build.json" manifest)
    string(JSON hash GET "${manifest}" source sha256)
    string(JSON is_fixture GET "${manifest}" fixtures)
    if(NOT hash STREQUAL capture_ffmpeg_hash OR NOT "${is_fixture}" STREQUAL "${fixtures}")
        message(FATAL_ERROR "${name}: wrong FFmpeg source hash or runtime/fixture profile")
    endif()
    add_library(${name} INTERFACE)
    foreach(library avformat avcodec avutil)
        if(NOT EXISTS "${prefix}/lib/lib${library}.a")
            message(FATAL_ERROR "${name}: missing lib${library}.a")
        endif()
        add_library(${name}-${library} STATIC IMPORTED GLOBAL)
        set_target_properties(${name}-${library} PROPERTIES
            IMPORTED_LOCATION "${prefix}/lib/lib${library}.a"
            INTERFACE_INCLUDE_DIRECTORIES "${prefix}/include")
        target_link_libraries(${name} INTERFACE ${name}-${library})
    endforeach()
    target_link_libraries(${name} INTERFACE Threads::Threads ${CMAKE_DL_LIBS})
    if(UNIX)
        target_link_libraries(${name} INTERFACE m)
    endif()
endfunction()

capture_import_ffmpeg(capture-ffmpeg "${CAPTURE_FFMPEG_ROOT}" OFF)
if(BUILD_TESTING)
    capture_import_ffmpeg(capture-ffmpeg-fixtures "${CAPTURE_FFMPEG_FIXTURE_ROOT}" ON)
endif()
