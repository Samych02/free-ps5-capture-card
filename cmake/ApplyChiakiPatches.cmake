find_package(Git REQUIRED)
file(READ "${ROOT}/Dependencies.lock.json" lock)
string(JSON expected_revision GET "${lock}" chiaki revision)
execute_process(COMMAND "${GIT_EXECUTABLE}" rev-parse HEAD WORKING_DIRECTORY "${SOURCE}"
    OUTPUT_VARIABLE revision OUTPUT_STRIP_TRAILING_WHITESPACE COMMAND_ERROR_IS_FATAL ANY)
if(NOT revision STREQUAL expected_revision)
    message(FATAL_ERROR "Chiaki revision mismatch: ${revision}")
endif()
string(JSON patch_count LENGTH "${lock}" chiaki patches)
math(EXPR last_patch "${patch_count} - 1")
foreach(index RANGE ${last_patch})
    string(JSON name GET "${lock}" chiaki patches ${index} file)
    string(JSON expected_hash GET "${lock}" chiaki patches ${index} sha256)
    set(patch "${ROOT}/${name}")
    file(SHA256 "${patch}" actual_hash)
    if(NOT actual_hash STREQUAL expected_hash)
        message(FATAL_ERROR "Patch hash mismatch: ${name}")
    endif()
    execute_process(COMMAND "${GIT_EXECUTABLE}" apply --check "${patch}"
        WORKING_DIRECTORY "${SOURCE}" RESULT_VARIABLE clean OUTPUT_QUIET ERROR_QUIET)
    if(clean EQUAL 0)
        execute_process(COMMAND "${GIT_EXECUTABLE}" apply "${patch}"
            WORKING_DIRECTORY "${SOURCE}" COMMAND_ERROR_IS_FATAL ANY)
    else()
        execute_process(COMMAND "${GIT_EXECUTABLE}" apply --reverse --check "${patch}"
            WORKING_DIRECTORY "${SOURCE}" RESULT_VARIABLE applied OUTPUT_QUIET ERROR_QUIET)
        if(NOT applied EQUAL 0)
            message(FATAL_ERROR "Patch does not apply cleanly and is not already applied: ${name}")
        endif()
    endif()
endforeach()
