index 0000000..d5cffa7
--- /dev/null
+++ b/lib/src/ctrlframe.h
@@ -0,0 +1,33 @@
+// SPDX-License-Identifier: LicenseRef-AGPL-3.0-only-OpenSSL
+#ifndef CHIAKI_CTRLFRAME_H
+#define CHIAKI_CTRLFRAME_H
+#include <stddef.h>
+#include <stdint.h>
+
+typedef enum {
+    CHIAKI_CTRL_FRAME_INCOMPLETE,
+    CHIAKI_CTRL_FRAME_READY,
+    CHIAKI_CTRL_FRAME_INVALID
+} ChiakiCtrlFrameState;
+
+/* Internal framing only: never decrypt or advance before a bounded full frame.
+ * Use one size_t byte count for the guard, subtraction and memmove pointer. */
+static inline ChiakiCtrlFrameState chiaki_ctrl_frame_size(const uint8_t *data,
+        size_t available, size_t capacity, size_t *frame_size)
+{
+    *frame_size = 0;
+    if(!data || capacity < 8 || available > capacity)
+        return CHIAKI_CTRL_FRAME_INVALID;
+    if(available < 8)
+        return CHIAKI_CTRL_FRAME_INCOMPLETE;
+    uint32_t payload_size = ((uint32_t)data[0] << 24) | ((uint32_t)data[1] << 16)
+        | ((uint32_t)data[2] << 8) | data[3];
+    if(payload_size > capacity - 8)
+        return CHIAKI_CTRL_FRAME_INVALID;
+    size_t total = 8 + (size_t)payload_size;
+    if(total > available)
+        return CHIAKI_CTRL_FRAME_INCOMPLETE;
+    *frame_size = total;
+    return CHIAKI_CTRL_FRAME_READY;
+}
+#endif
