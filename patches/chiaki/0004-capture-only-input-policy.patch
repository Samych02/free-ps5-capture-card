+static ChiakiErrorCode stream_connection_start_feedback(ChiakiStreamConnection *stream_connection)
+{
+	if(stream_connection->session->connect_info.capture_only)
+		return CHIAKI_ERR_SUCCESS;
+	ChiakiErrorCode err = chiaki_mutex_lock(&stream_connection->feedback_sender_mutex);
+	if(err != CHIAKI_ERR_SUCCESS)
+		return err;
+	if(stream_connection->feedback_sender_active)
+	{
+		chiaki_mutex_unlock(&stream_connection->feedback_sender_mutex);
+		return CHIAKI_ERR_SUCCESS;
+	}
+	err = chiaki_feedback_sender_init(&stream_connection->feedback_sender, &stream_connection->takion);
+	if(err == CHIAKI_ERR_SUCCESS)
+	{
+		stream_connection->feedback_sender_active = true;
+		chiaki_feedback_sender_set_controller_state(&stream_connection->feedback_sender, &stream_connection->session->controller_state);
+	}
+	chiaki_mutex_unlock(&stream_connection->feedback_sender_mutex);
+	return err;
+}
+
+static void stream_connection_stop_feedback(ChiakiStreamConnection *stream_connection)
+{
+	ChiakiErrorCode err = chiaki_mutex_lock(&stream_connection->feedback_sender_mutex);
+	assert(err == CHIAKI_ERR_SUCCESS);
+	if(stream_connection->feedback_sender_active)
+	{
+		stream_connection->feedback_sender_active = false;
+		chiaki_feedback_sender_fini(&stream_connection->feedback_sender);
+	}
+	chiaki_mutex_unlock(&stream_connection->feedback_sender_mutex);
+}
+
+static ChiakiErrorCode stream_connection_send_input_setup(ChiakiStreamConnection *stream_connection)
+{
+	if(stream_connection->session->connect_info.capture_only)
+		return CHIAKI_ERR_SUCCESS;
+	ChiakiErrorCode err = stream_connection_send_controller_connection(stream_connection);
+	if(err != CHIAKI_ERR_SUCCESS)
+		return err;
+	return stream_connection_enable_microphone(stream_connection);
+}
+
 static ChiakiErrorCode stream_connection_send_controller_connection(ChiakiStreamConnection *stream_connection)
 {
 	ChiakiSession *session = stream_connection->session;
