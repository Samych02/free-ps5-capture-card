+static bool encoded_sink_valid(ChiakiSession *session, const ChiakiEncodedMediaSink *sink)
+{
+	return sink->video_config && sink->audio_config && sink->video_packet && sink->audio_packet
+		&& !session->video_sample_cb && !session->audio_sink.header_cb && !session->audio_sink.frame_cb;
+}
+
 CHIAKI_EXPORT ChiakiErrorCode chiaki_session_start(ChiakiSession *session)
 {
+	chiaki_mutex_lock(&session->state_mutex);
+	if(session->media_started || session->should_stop ||
+		(session->encoded_sink_enabled && !encoded_sink_valid(session, &session->encoded_sink)))
+	{
+		chiaki_mutex_unlock(&session->state_mutex);
+		return CHIAKI_ERR_INVALID_DATA;
+	}
+	session->media_started = true;
 	ChiakiErrorCode err = chiaki_thread_create(&session->session_thread, session_thread_func, session);
 	if(err != CHIAKI_ERR_SUCCESS)
+	{
+		session->media_started = false;
+		chiaki_mutex_unlock(&session->state_mutex);
 		return err;
+	}
 	chiaki_thread_set_name(&session->session_thread, "Chiaki Session");
+	chiaki_mutex_unlock(&session->state_mutex);
 	return err;
 }
 
+CHIAKI_EXPORT ChiakiErrorCode chiaki_session_set_encoded_media_sink(ChiakiSession *session, const ChiakiEncodedMediaSink *sink)
+{
+	chiaki_mutex_lock(&session->state_mutex);
+	if(session->media_started || session->should_stop || (sink && !encoded_sink_valid(session, sink)))
+	{
+		chiaki_mutex_unlock(&session->state_mutex);
+		return CHIAKI_ERR_INVALID_DATA;
+	}
+	if(sink) session->encoded_sink = *sink;
+	else memset(&session->encoded_sink, 0, sizeof(session->encoded_sink));
+	session->encoded_sink_enabled = sink != NULL;
+	chiaki_mutex_unlock(&session->state_mutex);
+	return CHIAKI_ERR_SUCCESS;
+}
+
 CHIAKI_EXPORT ChiakiErrorCode chiaki_session_stop(ChiakiSession *session)
 {
 	ChiakiErrorCode err = chiaki_mutex_lock(&session->state_mutex);
