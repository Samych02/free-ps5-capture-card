+// SPDX-License-Identifier: LicenseRef-AGPL-3.0-only-OpenSSL
+#ifndef CHIAKI_ENCODEDMEDIA_H
+#define CHIAKI_ENCODEDMEDIA_H
+#include "common.h"
+#include <stddef.h>
+#include <stdint.h>
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+/* Alternate pre-start consumer, NOT a tee. All pointers are borrowed only for
+ * the duration of the callback. Never stop/join/finalize from these callbacks.
+ * Configuration generations are per track and reset with a new session.
+ * Headers retain authoritative codec/VUI/SEI metadata; nominal fps is the
+ * effective request, NOT evidence of actual coded cadence or A/V phase. */
+typedef struct chiaki_encoded_video_config_t {
+    uint64_t generation;
+    ChiakiCodec codec;
+    uint32_t width, height, nominal_fps_num, nominal_fps_den;
+    const uint8_t *header;
+    size_t header_size;
+} ChiakiEncodedVideoConfig;
+typedef struct chiaki_encoded_audio_config_t {
+    uint64_t generation;
+    uint32_t channels, sample_rate, samples_per_frame;
+    /* Game audio is Opus. No encoder lookahead/pre-skip is supplied on wire. */
+} ChiakiEncodedAudioConfig;
+enum {
+    CHIAKI_ENCODED_FEC_RECOVERED = 1,
+    CHIAKI_ENCODED_REFERENCE_REWRITTEN = 2,
+    CHIAKI_ENCODED_MISSING = 4
+};
+typedef struct chiaki_encoded_packet_t {
+    uint64_t generation, first_receipt_us;
+    uint16_t frame_index;
+    uint32_t flags, samples, lost_frames;
+    const uint8_t *data;
+    size_t size;
+} ChiakiEncodedPacket;
+typedef struct chiaki_encoded_media_sink_t {
+    void *user;
+    void (*video_config)(const ChiakiEncodedVideoConfig *, void *);
+    void (*audio_config)(const ChiakiEncodedAudioConfig *, void *);
+    /* true means accept (including intentional discard with no consumer), not
+     * successful decoding. false preserves upstream reference-failure policy. */
+    bool (*video_packet)(const ChiakiEncodedPacket *, void *);
+    void (*audio_packet)(const ChiakiEncodedPacket *, void *);
+} ChiakiEncodedMediaSink;
+#ifdef __cplusplus
+}
+#endif
+#endif
